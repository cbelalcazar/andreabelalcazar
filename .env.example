# Copiar a .env.local. Ninguna variable es obligatoria para compilar.

# Google Analytics 4. Por defecto el sitio usa G-5S474KXVJ8 (src/content/site.ts); esta variable lo sobreescribe.
NEXT_PUBLIC_GA_ID=

# Formulario de contacto (Resend). Sin RESEND_API_KEY el formulario no se muestra y la página ofrece WhatsApp y correo.
RESEND_API_KEY=
# Destino de los mensajes (por defecto, site.email)
CONTACT_TO_EMAIL=belalcazarmarketingdigital@gmail.com
# Remitente: debe ser un dominio verificado en Resend. Hoy el único verificado es labrujaa.com;
# cuando se verifique andreabelalcazar.com, cambiar a "Web Andrea Belalcázar <web@andreabelalcazar.com>".
CONTACT_FROM_EMAIL="Web Andrea Belalcázar <web@labrujaa.com>"

# URL pública (solo necesaria si cambia el dominio)
NEXT_PUBLIC_SITE_URL=https://www.andreabelalcazar.com
